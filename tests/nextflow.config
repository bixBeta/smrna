// The launch dir is the repo root, so the pipeline's own nextflow.config is
// loaded first and enables singularity. Turn it off before enabling docker:
// Nextflow refuses to run with both engines on.
singularity.enabled = false
docker.enabled = true

// Biocontainer rather than multiqc/multiqc, which sets an entrypoint that has
// to be overridden. 1.32 is the version bixbeta/trex-rna ships, so this checks
// the same MultiQC the pipeline actually runs.
process.container = 'quay.io/biocontainers/multiqc:1.32--pyhdfd78af_2'
