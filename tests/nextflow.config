// The launch dir is the repo root, so the pipeline's own nextflow.config loads
// first: it enables singularity and sets the process_mqc container to a
// docker:// URI, which is singularity syntax that the docker engine rejects.
// Override both, at the same label so this wins.
singularity.enabled = false
docker.enabled = true

process {
  withLabel:process_mqc {
    // Biocontainer rather than multiqc/multiqc, which sets an entrypoint that
    // would need overriding. 1.32 is the version bixbeta/trex-rna ships, so CI
    // exercises the same MultiQC the pipeline runs.
    container = 'quay.io/biocontainers/multiqc:1.32--pyhdfd78af_2'
  }
}
