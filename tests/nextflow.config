// The launch dir is the repo root, so the pipeline's own nextflow.config is
// loaded first and enables singularity. Turn it off before enabling docker:
// Nextflow refuses to have both engines on.
singularity.enabled = false
docker.enabled = true

// The smoke test only needs python3 + multiqc, not the pipeline's own image.
process.container = 'multiqc/multiqc:v1.25'
process.containerOptions = '--entrypoint ""'
